# Production build settings (loaded automatically by `npm run build`).
#
# REACT_APP_API_BASE is the origin the frontend calls for the API. Leave it EMPTY to call the API
# same-origin at "/api/..." — on Netlify the netlify.toml proxy forwards "/api/*" and "/uploads/*"
# to the backend, so there's no CORS and the backend URL stays hidden. If instead you point the
# frontend directly at the backend, set this to the full backend origin, e.g.
#   REACT_APP_API_BASE=https://your-backend.onrender.com
REACT_APP_API_BASE=
