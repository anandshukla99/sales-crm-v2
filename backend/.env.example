# Copy to .env and fill in real values. Do NOT commit .env.

# MySQL
# Local dev: point at your local MySQL (leave DB_SSL=false).
# Managed host (Aiven / TiDB Cloud / Railway / PlanetScale): use the connection details from your
# provider and set DB_SSL=true — managed MySQL requires a TLS connection.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sales_crm
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# App
PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# File uploads (relative to backend/). NOTE: on hosts with an ephemeral filesystem (e.g. Render's
# free tier) uploaded files do not survive a restart/redeploy — fine for a demo.
UPLOAD_DIR=uploads

# Initial admin login (created by the seed script if the users table is empty)
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_NAME=PMO
SEED_ADMIN_BU=signage
